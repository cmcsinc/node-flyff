{
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git init)",
      "Bash(git rm*)",
      "Bash(git rev-parse*)",
      "Bash(pnpm install*)",
      "Bash(pnpm -r build)",
      "Bash(pnpm -r lint)",
      "Bash(pnpm -r test)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * dev)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm --filter * add *)",
      "Bash(npx tsx --test *)",
      "Bash(npx tsx *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir -p *)",
      "Bash(cp *)",
      "Bash(mv *)"
    ],
    "additionalDirectories": [
      "/Users/owner/.claude/projects/-Users-owner-Cyril-nodejs-flyff",
      "/Users/owner/Cyril/nodejs-flyff",
      "/Users/owner/Cyril/nodejs-flyff/.claude",
      "/Users/owner/Cyril/nodejs-flyff/.claude/skills",
      "/Users/owner/Cyril/nodejs-flyff/.claude/state",
      "/Users/owner/Cyril/nodejs-flyff/packages",
      "/Users/owner/Cyril/nodejs-flyff/resources"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-tool-safety-guard.mjs",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-tool-checkpoint.mjs",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/post-tool-test-reminder.mjs",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "node .claude/hooks/post-tool-auto-test.mjs",
            "timeout": 35,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-session-checkpoint.mjs",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
