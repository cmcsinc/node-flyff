# =============================================================================
# Flyff Emulator — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  HOW CONFIG WORKS (read this first)                                     │
# │                                                                         │
# │  Most settings now live in structured config files:                     │
# │    config/default.json          ← shared defaults (committed)          │
# │    config/login-server.json     ← login server settings (committed)    │
# │    config/cluster-server.json   ← cluster server settings (committed)  │
# │    config/world-server.json     ← world server settings (committed)    │
# │    config/<name>.local.yml      ← your local overrides (gitignored)    │
# │                                                                         │
# │  This .env file is ONLY for SECRETS and infrastructure values that      │
# │  must not be committed (passwords, keys, connection strings).           │
# │                                                                         │
# │  Env vars override config files for the following fields ONLY:          │
# │    IPC_SECRET   → ipc.secret                                           │
# │    DATABASE_URL → database.url                                          │
# │    REDIS_URL    → cache.redisUrl                                        │
# │    SERVER_ID    → server.id  (optional identity override)               │
# │    DB_CLIENT    → database.client  (quick adapter switch)               │
# │    DB_FILENAME  → database.filename  (sqlite path override)             │
# │    CONFIG_FILE  → explicit path to a single config file (Docker/K8s)   │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================

# ---------------------------------------------------------------------------
# SECRETS — REQUIRED in production, must NEVER be committed
# ---------------------------------------------------------------------------

# Shared HMAC-SHA256 secret for all IPC messages between servers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be identical on all server processes.
IPC_SECRET=change-me-in-production-use-a-long-random-string

# JWT signing secret for the Next.js admin panel (next-auth v5).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The admin loads this SAME .env via a symlink at packages/admin/.env.local, so
# there is one shared env file for the whole monorepo - do not duplicate it.
AUTH_SECRET=change-me-in-production-use-a-long-random-base64-string

# ---------------------------------------------------------------------------
# Database connection — use ONLY ONE of the blocks below
# ---------------------------------------------------------------------------

# ── SQLite (local dev) ──────────────────────────────────────────────────────
DB_CLIENT=better-sqlite3
DB_FILENAME=./data/flyff_dev.sqlite3

# ── PostgreSQL (production) ─────────────────────────────────────────────────
# DB_CLIENT=pg
# DATABASE_URL=postgresql://user:password@localhost:5432/flyff

# ── MySQL / MariaDB (production) ────────────────────────────────────────────
# DB_CLIENT=mysql2
# DATABASE_URL=mysql://user:password@localhost:3306/flyff

# ---------------------------------------------------------------------------
# Redis (optional — falls back to MemoryCache if not set)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Docker / Kubernetes overrides (optional)
# ---------------------------------------------------------------------------
# Point to an explicit config file instead of using the discovery chain:
# CONFIG_FILE=/etc/flyff/world-server.json

# Override the server identity (useful when running multiple instances):
# SERVER_ID=world_2
