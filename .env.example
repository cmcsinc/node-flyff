# =============================================================================
# Flyff Emulator — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Adapter: sqlite3 | pg | mysql2
DB_CLIENT=sqlite3

# SQLite only (dev)
DB_FILENAME=./data/flyff_dev.sqlite3

# PostgreSQL / MySQL (production) — leave blank for SQLite
DATABASE_URL=

# ---------------------------------------------------------------------------
# Cache & IPC Transport
# ---------------------------------------------------------------------------
# Redis URL (used by @flyff/ipc pub/sub and ICacheAdapter)
# For local dev without Redis, ICacheAdapter falls back to MemoryCache
REDIS_URL=redis://localhost:6379

# Shared secret for HMAC-SHA256 signing of all IPC messages.
# MUST be the same value on all servers. Change in production!
IPC_SECRET=change-me-in-production-use-a-long-random-string

# ---------------------------------------------------------------------------
# Server Identity
# ---------------------------------------------------------------------------
# Unique ID for this server process (used in IPC message envelope "from" field)
SERVER_ID=world_1

# ---------------------------------------------------------------------------
# Network Ports
# ---------------------------------------------------------------------------
LOGIN_PORT=23000
CLUSTER_PORT=38100
WORLD_PORT=38180

# Internal IPC TCP port (cluster listens, world connects)
INTERNAL_IPC_PORT=29000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Argon2 memory cost in KiB (64 MB default). Lower for dev if slow.
ARGON2_MEMORY_COST=65536

# One-time session token TTL in ms (30 seconds)
TOKEN_TTL_MS=30000
