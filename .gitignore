# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test
.env.production
.env.local

# parcel-bundler cache (https://parceljs.org/)
.cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# OS metadata
.DS_Store
Thumbs.db

# Project-specific
packages/*/dist
packages/*/coverage
packages/*/.tsbuildinfo

# Compiled files in src directories (should only be in dist/)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Local config overrides — contain machine-specific settings, never commit
config/*.local.json
config/*.local.yml
config/*.local.yaml

# Runtime data files (SQLite WAL journals, dev databases)
# Cover root data/ AND nested packages/*/data/ — DB_FILENAME is CWD-relative so
# filter-launched servers/seed create stray DBs alongside each package.
data/*.sqlite3
data/*.sqlite3-wal
data/*.sqlite3-shm
packages/*/data/*.sqlite3
packages/*/data/*.sqlite3-wal
packages/*/data/*.sqlite3-shm

# Resources (Do not commit game data files)
resources/data/*.txt
resources/data/*.inc
resources/data/*.res
resources/data/*.wld
resources/data/*.rgn
!resources/data/.gitkeep

# Regenerable dev dumps (not consumed at runtime)
packages/resources/data/dialogues/_ALL.txt

# Game folder (client files, resources, etc.)
game/
game.zip


# Cygwin/MSYS crash dumps
*.stackdump

# Agent worktrees (full repo working copies, not source)
.claude/worktrees/

# Test artifact leak (repair.service.test.ts hardcodes this path)
.tmp-repair-test.sqlite3

# Temp propQuest extraction dumps (qt-<pid>-<ts>/propQuest.txt.txt)
qt-*/
packages/resources/qt-*/

# Admin server-manager: instance registry + generated per-instance configs
config/instances.json
config/instances/

# Supervisor daemon runtime state (pid/port handle + shared secret + child list)
data/supervisor.json
data/supervisor.token
data/supervisor-children.json
