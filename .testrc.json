{
  "patterns": {
    "test": "**/*.test.ts",
    "src": "**/*.ts",
    "coverage": ["packages/*/src/**/*.ts", "!packages/*/src/**/*.test.ts"]
  },
  "thresholds": {
    "statements": 80,
    "branches": 75,
    "functions": 80,
    "lines": 80
  },
  "ignore": [
    "node_modules/**",
    "dist/**",
    "**/*.d.ts",
    "scripts/**",
    ".claude/**",
    "resources/**"
  ]
}
