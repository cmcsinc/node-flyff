{
  "name": "flyff-nodejs",
  "version": "1.0.0",
  "description": "Modern Flyff (Fly For Fun) MMORPG server emulator in TypeScript/Node.js",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmcsinc/node-flyff.git"
  },
  "bugs": {
    "url": "https://github.com/cmcsinc/node-flyff/issues"
  },
  "homepage": "https://github.com/cmcsinc/node-flyff#readme",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "test": "node scripts/run-tests.mjs packages/*/test",
    "test:all": "node scripts/run-tests.mjs packages/*/test",
    "test:core": "node scripts/run-tests.mjs packages/core/test",
    "test:ipc": "node scripts/run-tests.mjs packages/ipc/test",
    "test:database": "node scripts/run-tests.mjs packages/database/test",
    "test:login": "node scripts/run-tests.mjs packages/login-server/test",
    "test:cluster": "node scripts/run-tests.mjs packages/cluster-server/test",
    "test:world": "node scripts/run-tests.mjs packages/world-server/test",
    "test:coverage": "node scripts/run-tests.mjs --experimental-test-coverage packages/*/test",
    "test:watch": "node scripts/run-tests.mjs --watch packages/*/test",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r -- lint --fix",
    "checkpoint": "tsx scripts/agent-checkpoint.ts",
    "servers": "node scripts/start-servers.mjs",
    "sv": "node scripts/supervisor.mjs",
    "sv:status": "node scripts/supervisor.mjs status",
    "sv:up": "node scripts/supervisor.mjs up",
    "sv:down": "node scripts/supervisor.mjs down",
    "sv:service": "node scripts/supervisor-service.mjs",
    "server:login": "tsx packages/login-server/src/index.ts",
    "server:cluster": "tsx packages/cluster-server/src/index.ts",
    "server:world": "tsx packages/world-server/src/index.ts",
    "admin": "pnpm --filter @flyff/admin dev",
    "admin:run": "node scripts/start-admin.mjs",
    "admin:build": "pnpm --filter @flyff/admin build",
    "admin:start": "pnpm --filter @flyff/admin start",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "claude": "claude --dangerously-skip-permissions",
    "claude:rc": "claude --dangerously-skip-permissions --rc"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "^20.12.7",
    "eslint": "9.18.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.5",
    "tsup": "^8.3.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "8.20.0"
  }
}
