{
  "name": "@flyff/cluster-server",
  "version": "1.0.0",
  "description": "Flyff Cluster Server — character select and creation (port 38100)",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flyff/core": "workspace:*",
    "@flyff/database": "workspace:*",
    "@flyff/ipc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
