{
  "name": "@flyff/combat",
  "version": "1.0.0",
  "description": "Flyff combat domain -- damage formulas, melee/skill pipeline, AI FSM, attack handlers + serializers",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./net/snapshot/*": "./dist/net/snapshot/*.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "tsx --test test/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flyff/core": "workspace:*",
    "@flyff/entities": "workspace:*",
    "@flyff/world-core": "workspace:*",
    "@flyff/database": "workspace:*",
    "@flyff/resources": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
