{
  "name": "@flyff/core",
  "version": "1.0.0",
  "description": "Shared core library — packet protocol, constants, errors, cache, event bus",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./net": "./src/net/index.ts",
    "./net/*.js": "./src/net/*.ts",
    "./constants/*.js": "./src/constants/*.ts",
    "./errors.js": "./src/errors.ts",
    "./logger.js": "./src/logger.ts",
    "./eventBus.js": "./src/eventBus.ts",
    "./cache": "./src/cache/index.ts",
    "./cache.js": "./src/cache/index.ts",
    "./config": "./src/config/index.ts",
    "./config/schemas/*": "./src/config/schemas/*.schema.ts",
    "./utils/password.js": "./src/utils/password.ts",
    "./utils/*.js": "./src/utils/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test test/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
