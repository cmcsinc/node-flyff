{
  "name": "@flyff/database",
  "version": "1.0.0",
  "description": "Database layer — Knex migrations, repositories, WAL journal (SQLite3/PG/MySQL)",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./repositories/*": "./dist/repositories/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test test/**/*.test.ts",
    "migrate": "tsx src/migrate.ts",
    "migrate:rollback": "tsx src/migrate.ts rollback",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flyff/core": "workspace:*",
    "better-sqlite3": "^9.6.0",
    "knex": "^3.1.0",
    "mysql2": "^3.9.7",
    "pg": "^8.11.5",
    "sqlite3": "^5.1.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
