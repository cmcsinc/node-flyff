{
  "name": "@flyff/entities",
  "version": "1.0.0",
  "description": "Flyff shared entity layer — CPlayer, CMover, slot/exp/vital math, authority/mode constants",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./constants/*": "./dist/constants/*.js",
    "./math/*": "./dist/math/*.js",
    "./tables/*": "./dist/tables/*.js",
    "./state/*": "./dist/state/*.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "tsx --test test/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flyff/core": "workspace:*",
    "@flyff/database": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
