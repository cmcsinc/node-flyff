  },
  "dependencies": {
    "@flyff/core": "workspace:*",
    "@flyff/database": "workspace:*",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
