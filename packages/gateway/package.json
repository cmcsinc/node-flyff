{
  "name": "@flyff/gateway",
  "version": "1.0.0",
  "description": "Unified WebSocket gateway server — auth, character select, and world in one process",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
