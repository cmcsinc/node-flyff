{
  "name": "@flyff/login-server",
  "version": "1.0.0",
  "description": "Flyff Login Server — authentication and server list (port 23000)",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "target": "node20",
    "platform": "node",
    "sourcemap": true,
    "clean": true,
    "banner": {
      "js": "import { createRequire } from 'module'; globalThis.require = createRequire(import.meta.url);"
    },
    "external": [
      "@flyff/core",
      "@flyff/database",
      "@flyff/ipc",
      "argon2",
      "pino",
      "zod",
      "@flyff/*"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "eslint src --ext .ts",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test test/**/*.test.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flyff/core": "workspace:*",
    "@flyff/database": "workspace:*",
    "@flyff/ipc": "workspace:*",
    "argon2": "^0.40.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
