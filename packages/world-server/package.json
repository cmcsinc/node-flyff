{
  "name": "@flyff/world-server",
  "version": "1.0.0",
  "description": "Flyff World Server — gameplay, combat, AI, zones (port 38180)",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test test/**/*.test.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flyff/core": "workspace:*",
    "@flyff/database": "workspace:*",
    "@flyff/ipc": "workspace:*",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
