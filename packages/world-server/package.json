{
  "name": "@flyff/world-server",
  "version": "1.0.0",
  "description": "Flyff World Server — gameplay, combat, AI, zones (port 38180)",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "target": "node20",
    "platform": "node",
    "sourcemap": true,
    "clean": true,
    "banner": {
      "js": "import { createRequire } from 'module'; globalThis.require = createRequire(import.meta.url);"
    },
    "external": [
      "@flyff/core",
      "@flyff/database",
      "@flyff/ipc",
      "@flyff/resources",
      "ioredis",
      "pino",
      "@flyff/*"
    ]
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test test/**/*.test.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flyff/core": "workspace:*",
    "@flyff/database": "workspace:*",
    "@flyff/ipc": "workspace:*",
    "@flyff/resources": "workspace:*",
    "ioredis": "^5.4.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@flyff/cluster-server": "workspace:*",
    "@flyff/login-server": "workspace:*",
    "@types/node": "^20.12.7",
    "argon2": "^0.40.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
