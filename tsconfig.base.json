{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@flyff/core": ["packages/core/src/index.ts"],
      "@flyff/core/*": ["packages/core/src/*"],
      "@flyff/ipc": ["packages/ipc/src/index.ts"],
      "@flyff/ipc/*": ["packages/ipc/src/*"],
      "@flyff/database": ["packages/database/src/index.ts"],
      "@flyff/database/*": ["packages/database/src/*"],
      "@flyff/resources": ["packages/resources/src/index.ts"],
      "@flyff/resources/*": ["packages/resources/src/*"],
      "@flyff/entities": ["packages/entities/src/index.ts"],
      "@flyff/entities/*": ["packages/entities/src/*"],
      "@flyff/world-core": ["packages/world-core/src/index.ts"],
      "@flyff/world-core/*": ["packages/world-core/src/*"],
      "@flyff/combat": ["packages/combat/src/index.ts"],
      "@flyff/combat/*": ["packages/combat/src/*"],
      "@flyff/inventory": ["packages/inventory/src/index.ts"],
      "@flyff/inventory/*": ["packages/inventory/src/*"],
      "@flyff/skills": ["packages/skills/src/index.ts"],
      "@flyff/skills/*": ["packages/skills/src/*"],
      "@flyff/quest": ["packages/quest/src/index.ts"],
      "@flyff/quest/*": ["packages/quest/src/*"],
      "@flyff/npc": ["packages/npc/src/index.ts"],
      "@flyff/npc/*": ["packages/npc/src/*"],
      "@flyff/mail": ["packages/mail/src/index.ts"],
      "@flyff/mail/*": ["packages/mail/src/*"],
      "@flyff/party": ["packages/party/src/index.ts"],
      "@flyff/party/*": ["packages/party/src/*"],
      "@flyff/guild": ["packages/guild/src/index.ts"],
      "@flyff/guild/*": ["packages/guild/src/*"],
      "@flyff/social": ["packages/social/src/index.ts"],
      "@flyff/social/*": ["packages/social/src/*"]
    }
  }
}
